{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MediTrail": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Supabase": {
    "Url": "",
    "ServiceKey": "",
    "Bucket": "documents",
    "BucketIsPublic": true
  },

  "Ai": {
    "Provider": "OpenRouter",
    "ApiKey": "",
    "BaseUrl": "",
    "ExtractionModel": "google/gemini-2.5-flash",
    "ReasoningModel": "google/gemini-2.5-flash",
    "Temperature": 0,
    "MaxTokens": 8000,
    "TimeoutSeconds": 120,
    "MaxAttempts": 3,
    "SiteName": "MediTrail"
  },

  "OpenFda": {
    "BaseUrl": "https://api.fda.gov",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "CacheHours": 24
  },

  "Features": {
    "DoctorRecommendation": false
  },

  "DoctorRecommendation": {
    "Provider": "overpass",
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org",
    "NominatimUserAgent": "MediTrail/1.0 (contact@example)",
    "NominatimTimeoutSeconds": 10,
    "OverpassTimeoutSeconds": 25,
    "CacheTtlHours": 24,
    "DefaultRadiusMeters": 5000,
    "FallbackRadiusMeters": 15000,
    "SuggestedNextRadiusMeters": 40000
  },

  "Pipeline": {
    "MaxFileSizeBytes": 10485760,
    "WorkerConcurrency": 3,
    "EnableExtractionCache": true
  },

  "Cors": {
    "AllowedOrigins": []
  }
}
