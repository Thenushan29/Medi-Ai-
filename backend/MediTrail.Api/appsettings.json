{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MediTrail": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": ""
  },

  "Supabase": {
    "Url": "",
    "ServiceKey": "",
    "Bucket": "documents",
    "BucketIsPublic": true
  },

  "OpenRouter": {
    "ApiKey": "",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "ExtractionModel": "google/gemini-2.5-flash",
    "ReasoningModel": "google/gemini-2.5-flash",
    "Temperature": 0,
    "MaxTokens": 8000,
    "TimeoutSeconds": 120,
    "MaxAttempts": 3,
    "SiteName": "MediTrail"
  },

  "OpenFda": {
    "BaseUrl": "https://api.fda.gov",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "CacheHours": 24
  },

  "Pipeline": {
    "MaxFileSizeBytes": 10485760,
    "WorkerConcurrency": 3,
    "EnableExtractionCache": true
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
