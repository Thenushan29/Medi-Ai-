# MediTrail — environment configuration.
# Copy to .env (gitignored) and fill in. Nothing here is committed with real values (§19).
#
# ASP.NET Core maps double underscore to config nesting: Supabase__ServiceKey -> Supabase:ServiceKey.

# ---- Database ----
# Supabase → Connect → Session pooler. Host is aws-1-<region>.pooler.supabase.com,
# username is postgres.<project-ref> (the project ref is part of the username, not just the host).
#
# Use SESSION mode (port 5432 on the pooler host), not transaction mode (6543):
#   - Session mode holds one Postgres connection per client connection, which is what a long-lived
#     ASP.NET Core app with EF Core expects. Transaction mode is for serverless functions and
#     breaks prepared statements.
#   - The pooler is also IPv4-reachable; the direct db.<ref>.supabase.co host is IPv6-only and will
#     fail on most home and CI networks.
ConnectionStrings__Postgres=Host=aws-1-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# Used only by `dotnet ef` commands. Same value as above is fine.
MEDITRAIL_CONNECTION_STRING=

# ---- Supabase Storage ----
Supabase__Url=https://<project-ref>.supabase.co
# Service-role key. SERVER SIDE ONLY — it bypasses row-level security. Never ship to the browser.
Supabase__ServiceKey=
Supabase__Bucket=documents
Supabase__BucketIsPublic=true

# ---- AI ----
OpenRouter__ApiKey=
OpenRouter__ExtractionModel=google/gemini-2.5-flash
OpenRouter__ReasoningModel=google/gemini-2.5-flash

# ---- openFDA (optional; works without a key at a lower rate limit) ----
OpenFda__ApiKey=

# ---- CORS ----
# The deployed frontend origin. Add the Vercel URL before submission.
Cors__AllowedOrigins__0=http://localhost:4200
